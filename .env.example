# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/dairy_farm_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@dairyfarm.com
EMAIL_FROM_NAME=Dairy Farm Management
NOTIFICATION_EMAIL=your-email@example.com  # Recipient for auto-generated notifications

# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Search for "App Passwords" or go to https://myaccount.google.com/apppasswords
# 4. Generate a new app password for "Mail"
# 5. Copy the 16-character password (without spaces) and use it as SMTP_PASS above
# 6. Set NOTIFICATION_EMAIL to the email where you want to receive notifications
#
# The system will automatically send pregnancy check reminders 90 days after insemination
# Emails are checked and sent every hour automatically